[Unit]
Description=Guaranine protected first-boot enrollment setup
After=systemd-user-sessions.service NetworkManager.service
Before=getty@tty1.service serial-getty@ttyS0.service
ConditionPathExists=!/var/lib/guaranine/configured

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/guaranine-worker configure
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
RemainAfterExit=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
