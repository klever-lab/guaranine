[Unit]
Description=Verify and enroll this Guaranine worker
Wants=tailscaled.service
After=network.target NetworkManager.service tailscaled.service
ConditionPathExists=/var/lib/guaranine/configured

[Service]
Type=oneshot
UMask=0077
RuntimeDirectory=guaranine
RuntimeDirectoryMode=0700
ExecStart=/usr/local/sbin/guaranine-worker enroll
TimeoutStartSec=12min
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
