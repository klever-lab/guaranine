[Unit]
Description=Tailscale mesh transport
Wants=network-pre.target
After=network-pre.target NetworkManager.service

[Service]
Type=notify
RuntimeDirectory=tailscale
StateDirectory=tailscale
ExecStart=/usr/local/sbin/tailscaled --state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock --port=41641
Restart=on-failure
RestartSec=10
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
